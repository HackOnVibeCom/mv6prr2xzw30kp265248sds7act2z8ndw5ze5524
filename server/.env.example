# ─────────────────────────────────────────────────────────────────────────────
# AutoPromo API server configuration
#
#   cp .env.example .env    then fill in the values below
#
# Everything here is SERVER-ONLY and must never reach a browser.
# .env is gitignored — only this .example file belongs in version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase → Settings → API → service_role (SECRET — bypasses row-level security)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# console.groq.com → API Keys (starts with gsk_)
GROQ_API_KEY=your_groq_key_here

# ── Optional ─────────────────────────────────────────────────────────────────

# Discord → channel settings → Integrations → Webhooks
# Leave blank to disable the automatic Discord post on every event.
DISCORD_WEBHOOK_URL=

# Port the API listens on.
PORT=3001

# Origin of the dashboard, used for CORS.
# The Vite dev server defaults to 8080 (and climbs if that's taken).
FRONTEND_URL=http://localhost:8080

# Extra allowed origins, comma-separated. Add your deployed dashboard here.
# ALLOWED_ORIGINS=https://autopromo.vercel.app,https://staging.autopromo.app

# ── Not used by the server ───────────────────────────────────────────────────
# The anon key is only needed if you add direct client-side Supabase Realtime
# subscriptions. It is safe to expose publicly (it's protected by RLS).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
