# ─────────────────────────────────────────────────────────────────────────────
# AutoPromo dashboard (frontend) configuration
#
#   cp .env.example .env    then adjust if needed
#
# ⚠️  ONLY put non-secret values here.
#
# Vite inlines every VITE_-prefixed variable into the JavaScript bundle that
# ships to the browser. Anyone can read them with devtools. API keys, service
# role keys and webhook URLs belong in server/.env — never in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the AutoPromo API server (the Express app in server/).
# Defaults to http://localhost:3001/api when unset.
VITE_API_URL=http://localhost:3001/api
